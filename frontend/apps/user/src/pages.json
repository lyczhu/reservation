{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "预约"
      }
    },
    {
      "path": "pages/service/list",
      "style": {
        "navigationBarTitleText": "全部服务"
      }
    },
    {
      "path": "pages/service/detail",
      "style": {
        "navigationBarTitleText": "服务详情"
      }
    },
    {
      "path": "pages/booking/index",
      "style": {
        "navigationBarTitleText": "预约"
      }
    },
    {
      "path": "pages/booking/success",
      "style": {
        "navigationBarTitleText": "预约成功",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/reservation/list",
      "style": {
        "navigationBarTitleText": "我的预约"
      }
    },
    {
      "path": "pages/reservation/detail",
      "style": {
        "navigationBarTitleText": "预约详情"
      }
    },
    {
      "path": "pages/reservation/reschedule",
      "style": {
        "navigationBarTitleText": "修改预约时间"
      }
    },
    {
      "path": "pages/me/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/legal/privacy",
      "style": {
        "navigationBarTitleText": "隐私政策"
      }
    },
    {
      "path": "pages/legal/agreement",
      "style": {
        "navigationBarTitleText": "用户协议"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTitleText": "预约",
    "navigationBarBackgroundColor": "#FFFFFF",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#FAF6F2",
    // #ifdef H5
    "rpxCalcMaxDeviceWidth": 480,
    "rpxCalcBaseDeviceWidth": 480
    // #endif
  }
}
