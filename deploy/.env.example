# ===== 运行环境 =====
# 本地开发保持注释（默认 dev）；生产部署必须取消注释
# SPRING_PROFILES_ACTIVE=prod

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DB=reservation
MYSQL_USER=reservation
MYSQL_PASSWORD=reservation

# ===== Redis =====
REDIS_PASSWORD=

# ===== 对象存储（RustFS） =====
# 该地址同时作为 S3 客户端 endpoint 与图片 URL 前缀，生产必须填小程序可访问的 HTTPS 地址
# RUSTFS_ENDPOINT=https://files.example.com
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=reservation

# ===== 安全密钥（生产必须替换为强随机值） =====
PHONE_AES_KEY=
PHONE_HASH_KEY=
VERIFY_CODE_SECRET=

# ===== 微信小程序（user=用户端 / staff=商家端） =====
WX_USER_APPID=
WX_USER_SECRET=
WX_STAFF_APPID=
WX_STAFF_SECRET=

# ===== 订阅消息模板（微信公众平台一次性订阅模板 ID，未配置时降级为日志） =====
WX_TPL_SUCCESS=
WX_TPL_CHANGE=
WX_TPL_REMINDER=
WX_TPL_NEW_RESERVATION=